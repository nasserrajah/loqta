# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (future React frontend).
CORS_ORIGINS=http://localhost:5173
# Public URL of the future frontend; used in password-reset links.
APP_URL=http://localhost:5173
# SQLite file path. Relative paths are resolved from the apps/api package root.
DATABASE_PATH=./data/loqta.db
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=10
# Failed attempts allowed across sensitive auth endpoints per 15-minute window and IP.
RATE_LIMIT_MAX=20
# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
