{
  "name": "loqta",
  "version": "0.1.0",
  "private": true,
  "description": "Loqta | لُقطة — demo electronics e-commerce platform (backend first).",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @loqta/api",
    "build": "npm run clean && npm run build -w @loqta/api",
    "start": "npm run start -w @loqta/api",
    "test": "npm run test -w @loqta/api",
    "typecheck": "npm run typecheck -w @loqta/api",
    "lint": "eslint .",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
